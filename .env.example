# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication
JWT_SECRET=supersecret_logistics_jwt_key_2026_dbms_project
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Database Engine Mode
# Options: 'embedded' (zero-friction built-in multi-model engine) or 'external' (real DB servers)
DB_MODE=embedded

# Relational Database (PostgreSQL / MySQL)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=logistics_db
PG_USER=postgres
PG_PASSWORD=postgres_password

# NoSQL Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/logistics_nosql

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Cache Layer (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_DEFAULT=300

# AWS Cloud Integration (Demonstration / Mock Config)
AWS_REGION=us-east-1
AWS_S3_BUCKET=logistics-pod-documents-student-demo
AWS_RDS_ENDPOINT=logistics-postgres.c4a1b2c3d4e5.us-east-1.rds.amazonaws.com
